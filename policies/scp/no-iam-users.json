{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoIAMUsersOrAccessKeys",
      "Effect": "Deny",
      "Action": ["iam:CreateUser", "iam:CreateAccessKey", "iam:CreateLoginProfile"],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": { "aws:PrincipalArn": "arn:aws:iam::*:role/platform-guardrails" }
      }
    }
  ]
}
